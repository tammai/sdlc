{
  "$comment": "contracts-version: 1.1.1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "finding-v1 (C6)",
  "type": "object",
  "required": [
    "id",
    "source",
    "class",
    "severity",
    "criterion",
    "rule",
    "repro",
    "observed",
    "route",
    "verified_by"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]+-[0-9]+$"
    },
    "source": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "class": {
      "type": "string",
      "enum": [
        "build-defect",
        "spec-gap",
        "reference-defect",
        "accepted-departure",
        "test-defect",
        "flaky",
        "environment"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "criterion": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(F-[A-Z][A-Z0-9]*-[0-9]+\\.AC[0-9]+|AC-[0-9]{3,})$"
    },
    "rule": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "repro": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "runner"
      ],
      "properties": {
        "runner": {
          "type": "string",
          "enum": [
            "http",
            "playwright",
            "maestro",
            "cli"
          ]
        }
      }
    },
    "observed": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "rebuild",
        "reference"
      ],
      "properties": {}
    },
    "route": {
      "type": "string",
      "enum": [
        "sdlc",
        "rspec",
        "human",
        "drop",
        "orchestrator"
      ]
    },
    "verified_by": {
      "type": "object",
      "required": [
        "agent",
        "result"
      ],
      "properties": {
        "agent": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "result": {
          "type": "string",
          "pattern": "^(reproduced|not-reproduced|not run: .+)$"
        }
      }
    }
  }
}
