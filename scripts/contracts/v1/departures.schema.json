{
  "$comment": "contracts-version: 1.1.1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "departures.yaml (C5)",
  "description": "The one list of accepted differences between the rebuild and the reference.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "kind",
      "summary"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^D-[0-9]{3,}$"
      },
      "kind": {
        "type": "string",
        "enum": [
          "simplification",
          "deliberate-change",
          "reference-defect-not-copied",
          "environment",
          "branding"
        ]
      },
      "criteria": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^(F-[A-Z][A-Z0-9]*-[0-9]+\\.AC[0-9]+|AC-[0-9]{3,})$"
        }
      },
      "features": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^F-[A-Z][A-Z0-9]*-[0-9]+$"
        }
      },
      "summary": {
        "type": "string",
        "minLength": 1
      },
      "match": {
        "type": [
          "array",
          "null"
        ],
        "items": {
          "type": "object",
          "required": [
            "runner",
            "rule"
          ],
          "properties": {
            "runner": {
              "type": "string",
              "enum": [
                "http",
                "playwright",
                "maestro",
                "cli"
              ]
            },
            "pointer": {
              "type": "string"
            },
            "rule": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "decided_by": {
        "type": "string"
      },
      "adr": {
        "type": "string",
        "minLength": 1
      },
      "status": {
        "type": "string",
        "enum": [
          "proposed",
          "accepted"
        ]
      }
    }
  }
}
