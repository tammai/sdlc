{
  "contract": {
    "required": [
      "install",
      "test",
      "lint",
      "typecheck",
      "build"
    ]
  },
  "verify": {
    "order": [
      "lint",
      "typecheck",
      "build",
      "test"
    ]
  },
  "baseline": ".sdlc/baseline.md",
  "areas": {
    "source": [
      "**/*.{ts,tsx,js,jsx,mjs,cjs,vue,svelte}",
      "**/*.{py,go,rs,java,kt,rb,php,cs,swift}"
    ],
    "ui": [
      "**/*.{tsx,jsx,vue,svelte,astro,html,css,scss,sass,less}"
    ],
    "tests": [
      "**/*.{test,spec}.*",
      "**/{test,tests,__tests__,spec}/**",
      "**/test_*.py",
      "**/*_test.{py,go}"
    ],
    "migrations": [
      "**/migrations/**",
      "**/migrate/**",
      "**/prisma/schema.prisma"
    ],
    "sensitive": [
      "**/{auth,authn,authz,session,sessions,payments,payment,billing,checkout}/**",
      "**/*{secret,credential,token,crypto}*",
      "**/.env*"
    ],
    "ci": [
      ".github/**",
      "**/Dockerfile*",
      "**/docker-compose*.{yml,yaml}",
      "**/*.tf",
      "{infra,infras,deploy,k8s,helm}/**"
    ]
  },
  "ci": {
    "os": [
      "ubuntu-latest"
    ],
    "node_version": "22",
    "java_version": "21",
    "dotnet_version": "8.0.x",
    "oasdiff_version": "1.33.0"
  },
  "companions": [
    {
      "id": "sdlc-extras@sdlc",
      "marketplace": "sdlc",
      "why": "the Ralph loop, hookify list/configure/help, and extra review agents (type design, comments, simplifier)",
      "default": false
    }
  ],
  "conflicts": [
    {
      "name": "superpowers",
      "plugin": "superpowers",
      "why": "sdlc carries its own copies of superpowers' skills (brainstorming, test-driven development, systematic debugging, writing plans); with both on, two near-identical sets compete to trigger"
    },
    {
      "name": "spec-kit",
      "files": [
        ".specify/",
        ".claude/commands/speckit.*"
      ],
      "why": "spec-kit's specify/plan/tasks commands are a second spec workflow beside sdlc's Define; an existing spec-kit spec.md can stay as the written spec sdlc links to"
    }
  ]
}
